generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  firebaseUid      String    @unique
  email            String    @unique
  name             String?
  avatarUrl        String?
  isPremium        Boolean   @default(false)
  premiumExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  settings        UserSettings?
  purchases       Purchase[]
  communityPrices CommunityPrice[]
  subscription    Subscription?
  userPromoCodes  UserPromoCode[]

  @@map("users")
}

model UserSettings {
  id               String  @id @default(uuid())
  userId           String  @unique
  shareAnonymously Boolean @default(false)
  shareCity        Boolean @default(false)
  shareState       Boolean @default(true)
  notifications    Boolean @default(true)
  currency         String  @default("BRL")
  language         String  @default("pt-BR")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Product {
  id          String   @id @default(uuid())
  barcode     String?  @unique
  name        String
  brand       String?
  category    String?
  unit        String?
  imageUrl    String?
  description String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images          ProductImage[]
  purchaseItems   PurchaseItem[]
  communityPrices CommunityPrice[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Market {
  id        String   @id @default(uuid())
  name      String
  address   String?
  city      String?
  state     String?
  zipCode   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases       Purchase[]
  communityPrices CommunityPrice[]

  @@map("markets")
}

model Purchase {
  id         String   @id @default(uuid())
  userId     String
  marketId   String?
  totalValue Float
  purchaseAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market?       @relation(fields: [marketId], references: [id])
  items  PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Float
  unitPrice  Float
  totalPrice Float
  unit       String?
  notes      String?
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model CommunityPrice {
  id         String   @id @default(uuid())
  productId  String
  marketId   String?
  price      Float
  city       String?
  state      String?
  reportedAt DateTime @default(now())
  isVerified Boolean  @default(false)
  userId     String?

  product Product  @relation(fields: [productId], references: [id])
  market  Market?  @relation(fields: [marketId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@map("community_prices")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  plan             String    @default("FREE")
  status           String    @default("ACTIVE")
  startedAt        DateTime  @default(now())
  expiresAt        DateTime?
  stripeCustomerId String?
  stripeSubId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Float
  maxUses       Int?
  currentUses   Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  userPromoCodes UserPromoCode[]

  @@map("promo_codes")
}

model UserPromoCode {
  id          String   @id @default(uuid())
  userId      String
  promoCodeId String
  usedAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([userId, promoCodeId])
  @@map("user_promo_codes")
}

model AiAnalysis {
  id         String   @id @default(uuid())
  userId     String
  type       String
  prompt     String?
  result     Json?
  tokensUsed Int?
  createdAt  DateTime @default(now())

  @@map("ai_analysis")
}
